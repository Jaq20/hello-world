# PropFlip environment configuration.
# Copy to ".env" and adjust as needed.

# Database connection. SQLite by default for local development.
# To use Postgres, set the provider in prisma/schema.prisma to "postgresql"
# and point this at your connection string.
DATABASE_URL="file:./dev.db"

# Directory for uploaded deal photos (kept out of the database to minimize
# storage cost). Defaults to ./uploads. For production, point this at a
# persistent volume, or swap src/lib/storage.ts for S3 / Cloudflare R2.
UPLOAD_DIR="./uploads"
