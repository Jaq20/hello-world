# PropFlip environment configuration. Copy to ".env" and fill in.

# --- Database (PostgreSQL) ---------------------------------------------------
# For Supabase, use the Connection Pooling string (port 6543) for the app and
# the direct connection (port 5432) for running migrations.
# Example (Supabase): postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
DATABASE_URL="postgresql://user:password@localhost:5432/propflip?schema=public"

# --- File storage ------------------------------------------------------------
# local    -> filesystem under UPLOAD_DIR (dev default)
# supabase -> Supabase Storage (private bucket; production)
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"

# Required only when STORAGE_DRIVER=supabase:
# SUPABASE_URL="https://[REF].supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="service-role-key"   # server-only secret
# SUPABASE_STORAGE_BUCKET="deal-photos"          # create as a PRIVATE bucket

# --- Email (password reset) --------------------------------------------------
# If RESEND_API_KEY is unset, reset links are logged to the server console.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="PropFlip <noreply@yourdomain.com>"
